# studyweb server environment — systemd EnvironmentFile format.
#
#   sudo install -m 600 -o studyweb env.example /opt/studyweb/env
#   sudo systemctl restart studyweb
#
# Format rules: no `export`, no shell expansion, and comments only on their own
# line (a `#` after a value is part of the value). To load the same file into a
# shell instead:  set -a; . /opt/studyweb/env; set +a

# --- Server -----------------------------------------------------------------
# Required on anything but loopback. Generate: openssl rand -hex 24
STUDYWEB_API_KEY=CHANGE_ME
# Empty = send no CORS header. Set an explicit origin only for browser clients.
STUDYWEB_CORS_ORIGIN=
# SSRF guard. true ONLY if you deliberately fetch intranet addresses.
STUDYWEB_ALLOW_PRIVATE=false
STUDYWEB_MAX_REQUEST_BYTES=1000000
STUDYWEB_MAX_CONCURRENT_REQUESTS=4

# --- Paths (match the systemd unit's CacheDirectory / StateDirectory) --------
STUDYWEB_CACHE_DIR=/var/cache/studyweb
STUDYWEB_CACHE=true
STUDYWEB_CACHE_TTL=3600
STUDYWEB_CACHE_MAX_MB=500
# Where the usage ledger and the price-override file live. Without these a
# service user with no real home writes them somewhere surprising.
XDG_DATA_HOME=/var/lib/studyweb
XDG_CONFIG_HOME=/etc/studyweb

# --- Search -----------------------------------------------------------------
STUDYWEB_PROVIDER=auto
STUDYWEB_MARKET=ko-KR
STUDYWEB_MAX_RESULTS=6
# DuckDuckGo is unroutable from KR networks: every attempt burns a full connect
# timeout, twice when the domain-scoped recall retry fires. Drop it from the chain.
STUDYWEB_SEARCH_DISABLE=duckduckgo

# Sites that `studyweb prices` / POST /prices checks, in buyer order.
# Coupang, 11st and Naver shopping need STUDYWEB_RENDER=true (with chromium
# installed) or the Naver API keys below — a static fetch gets a JS shell.
STUDYWEB_PRICE_SITES=danawa.com,shopping.naver.com,11st.co.kr,coupang.com

# Naver Open API — free 25k calls/day. Enables the "naver" web provider and the
# "naver_shop" price vertical. Register at developers.naver.com.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Private SearXNG next door — see deploy/searxng/. Needs formats: [html, json].
# Uncomment once the container answers; until then it just fails first in the chain.
# SEARXNG_URL=http://127.0.0.1:8888

# Optional keyed engines (leave blank to skip)
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Fetching ---------------------------------------------------------------
STUDYWEB_RESPECT_ROBOTS=true
STUDYWEB_PER_HOST_DELAY=1.0
STUDYWEB_TIMEOUT=15
STUDYWEB_MAX_WORKERS=8
STUDYWEB_MAX_BYTES=4000000
STUDYWEB_RECOVER_URLS=true
# Headless-Chrome fallback for JS-rendered pages. A bare VPS has no Chrome —
# leaving this on costs a failed probe per thin page. Set true after installing
# chromium and pointing STUDYWEB_CHROME at it.
STUDYWEB_RENDER=false
# STUDYWEB_CHROME=/usr/bin/chromium

# --- Model providers --------------------------------------------------------
# Keys live here, in the server's own environment. Clients never send them.
# Default provider for /chat, /agent, `studyweb ask`, and LLM extraction.
STUDYWEB_PROVIDER_LLM=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
NVIDIA_API_KEY=
STUDYWEB_LLM_MAX_TOKENS=8192
STUDYWEB_LLM_TIMEOUT=120

# LM Studio lives on your laptop, not this box. Either leave the lmstudio
# provider unreachable (harmless), or forward it in with:
#   ssh -R 1234:127.0.0.1:1234 user@this-server
# STUDYWEB_LLM_BASE=http://127.0.0.1:1234/v1
