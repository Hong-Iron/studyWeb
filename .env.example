# Copy to `.env` and `export $(grep -v '^#' .env | xargs)` — or just set these
# in your shell. Everything works with NO keys set; keys only upgrade search.

# --- HTTP / politeness ---
# STUDYWEB_UA="Mozilla/5.0 ..."        # override the default browser User-Agent
STUDYWEB_RESPECT_ROBOTS=true            # honour robots.txt (default true)
STUDYWEB_PER_HOST_DELAY=1.0             # seconds between requests to one host
STUDYWEB_TIMEOUT=15                     # per-request timeout (s)
STUDYWEB_MAX_WORKERS=8                  # concurrent fetches
STUDYWEB_MAX_BYTES=4000000             # cap per-response download size
# SSRF guard: refuse private/loopback/link-local hosts. Set true ONLY for
# deliberate intranet use (fetching internal addresses).
STUDYWEB_ALLOW_PRIVATE=false

# --- Search ---
STUDYWEB_PROVIDER=auto                  # auto | bing | wikipedia | brave | tavily | ...
STUDYWEB_MARKET=en-US                   # Bing market, e.g. en-US or ko-KR
STUDYWEB_MAX_RESULTS=6
# Skip engines that are unreachable from your network — each dead one costs a
# full connect timeout per search before the chain moves on.
# STUDYWEB_SEARCH_DISABLE=duckduckgo
# Sites checked by `studyweb prices` / POST /prices, in buyer order.
STUDYWEB_PRICE_SITES=danawa.com,shopping.naver.com,11st.co.kr,coupang.com

# --- Optional key-based search providers (only used when set) ---
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# SEARXNG_URL=http://127.0.0.1:8888     # see deploy/searxng/ for a compose file
# Naver Open API (developers.naver.com) — free 25k calls/day. Enables the
# "naver" web provider and the "naver_shop" price vertical.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# --- Cache ---
STUDYWEB_CACHE=true
STUDYWEB_CACHE_TTL=3600                 # seconds
STUDYWEB_CACHE_MAX_MB=500               # evict oldest entries past this size
# STUDYWEB_CACHE_DIR=~/.cache/studyweb

# --- Structured extraction (extract_data / POST /extract-data) ---
STUDYWEB_LLM_BASE=http://localhost:1234/v1   # local OpenAI-compatible LLM (LM Studio)
# STUDYWEB_LLM_MODEL=                    # "" = use the first loaded model
STUDYWEB_LLM_TIMEOUT=120                 # seconds

# --- Cloud model providers (POST /chat, /agent, `studyweb ask`) ---
# Keys live here, in the server's own environment — clients never send them.
# Every provider is optional; unset ones report status "no_key" and stay unused.
STUDYWEB_PROVIDER_LLM=lmstudio           # default provider: lmstudio | openai | anthropic | nvidia | claude-code | custom
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# STUDYWEB_CUSTOM_API_KEY=
# Per-provider model / endpoint overrides (defaults shown in `studyweb providers`):
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# STUDYWEB_CUSTOM_BASE=http://localhost:11434/v1
# OPENAI_BASE_URL= / ANTHROPIC_BASE_URL= / NVIDIA_BASE_URL=   # for proxies or Azure-style gateways
# STUDYWEB_CLAUDE_BIN=claude             # binary for the "claude-code" provider
STUDYWEB_LLM_MAX_TOKENS=8192
# STUDYWEB_LLM_EFFORT=                   # "" | low | medium | high (Claude output effort)
# STUDYWEB_USAGE_PERSIST=0               # 1/unset = log tokens+cost to ~/.local/share/studyweb

# --- URL recovery (hallucinated / 404 URLs) ---
STUDYWEB_RECOVER_URLS=true               # on open_url/extract_data failure, search the same site for the intended page
STUDYWEB_RECOVER_MAX=5                    # max candidate URLs to consider

# --- Headless-browser fallback (JS-rendered pages) ---
STUDYWEB_RENDER=true                     # allow headless Chrome fallback when static is thin
# STUDYWEB_CHROME=                       # path to chrome/chromium ("" = autodetect)
STUDYWEB_RENDER_TIMEOUT=25               # seconds
STUDYWEB_RENDER_THIN=200                 # static text shorter than this (words) triggers render

# --- Server ---
# STUDYWEB_API_KEY=change-me            # if set, the HTTP API requires it
# STUDYWEB_CORS_ORIGIN=                 # empty = no CORS header (safest);
#                                       # set "*" or an origin only for browser clients
STUDYWEB_MAX_REQUEST_BYTES=1000000     # reject request bodies larger than this
STUDYWEB_MAX_CONCURRENT_REQUESTS=4     # cap simultaneous search/rag pipelines
